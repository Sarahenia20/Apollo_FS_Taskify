pipeline {
    agent any
    environment {
        registryCredentials = "nexus"
        registry = "192.168.33.10:8083"
        //SONAR_SCANNER_OPTS = "-Xmx4g"
        //NODE_OPTIONS = "--max-old-space-size=4096"
        //NEXUS_USER = "admin"
        //NEXUS_PASSWORD = "nexus"
    }
    
    stages {

        
       stage('Install Client Dependencies') {
            steps {
                script {
                    dir('client') {
                        sh 'npm install'
                    }
                }
            }
        }
        
        stage('Install Server Dependencies') {
            steps {
                script {
                    dir('server') {
                        sh 'npm install'
                    }
                }
            }
        }
        
        stage('Client Tests') {
            steps {
                script {
                    dir('client') {
                        sh 'npm test || echo "No test script found, skipping tests"'
                    }
                }
            }
        }
        
        stage('Server Tests') {
            steps {
                script {
                    dir('server') {
                        sh 'echo "No test script found, skipping tests"'
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps{
                script {
                    def scannerHome = tool 'scanner'
                        withSonarQubeEnv {
                        sh "${scannerHome}/bin/sonar-scanner"
                    }
                }
            }
        }

        
        stage('Build Client') {
            steps {
                script {
                    dir('client') {
                        sh 'npm run build || echo "Build script failed, check package.json for correct script name"'
                    }
                }
            }
        }
        
        stage('Build Server') {
            steps {
                script {
                    dir('server') {
                        sh 'npm run build || echo "No build script for server, or script failed. Check package.json for correct script name"'
                    }
                }
            }
        }
        
        /*stage('Building Docker Images') {
            steps {
                script {
                    sh 'docker-compose build'
                }
            }
        }
        
         stage('Deploy to Nexus') {
            steps {
                script {
                    sh '''
                        # Authenticate with Nexus Docker registry using correct credentials
                        echo "Logging in to Nexus Docker registry..."
                        echo "${NEXUS_PASSWORD}" | docker login 192.168.33.10:8083 -u ${NEXUS_USER} --password-stdin
                        
                        # Check login succeeded
                        if [ $? -eq 0 ]; then
                            echo "Login successful, pushing image..."
                            docker push 192.168.33.10:8083/nodemongoapp:6.0
                            
                            # Check push succeeded
                            if [ $? -eq 0 ]; then
                                echo "Successfully pushed image to Nexus!"
                            else
                                echo "Failed to push image. Check if the repository exists in Nexus."
                            fi
                        else
                            echo "Login failed. Verify Nexus Docker registry settings."
                            echo "Make sure Docker Bearer Token Realm is enabled."
                        fi
                        
                        # Always try to logout
                        docker logout 192.168.33.10:8083 || true
                    '''
                }
            }
        }*/
    
    }
    
    post {
        always {
            echo 'Cleaning up workspace'
            sh '''
                # Clean up node_modules in both directories
                rm -rf client/node_modules server/node_modules || true
                
                # Clean up SonarQube temp files
                rm -rf .scannerwork || true
                
                # Print disk usage for debugging
                echo "Disk usage after cleanup:"
                df -h
            '''
        }
        success {
            echo 'Build completed successfully!'
        }
        failure {
            echo 'Build failed!'
        }
    }
}