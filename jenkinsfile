pipeline {
    agent any
    environment {
        registryCredentials = "nexus"
        registry = "192.168.33.10:8083"
        //SONAR_SCANNER_OPTS = "-Xmx2g" // Increase memory for SonarQube
    }
    
    stages {
        stage('Install Client Dependencies') {
            steps {
                script {
                    dir('client') {
                        sh 'rm -rf node_modules package-lock.json'
                        sh 'npm install'
                    }
                }
            }
        }
        
        stage('Install Server Dependencies') {
            steps {
                script {
                    dir('server') {
                        sh 'npm install'
                    }
                }
            }
        }
        
        stage('Client Tests') {
            steps {
                script {
                    dir('client') {
                        sh 'npm test || echo "No test script found, skipping tests"'
                    }
                }
            }
        }
        
        stage('Server Tests') {
            steps {
                script {
                    dir('server') {
                        sh 'echo "No test script found, skipping tests"'
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
steps{
script {
def scannerHome = tool 'scanner'
withSonarQubeEnv {
sh "${scannerHome}/bin/sonar-scanner"
}
}
}
}
        
        stage('Build Client') {
            steps {
                script {
                    dir('client') {
                        sh 'npm run build || echo "Build script failed, check package.json for correct script name"'
                    }
                }
            }
        }
        
        stage('Build Server') {
            steps {
                script {
                    dir('server') {
                        sh 'npm run build || echo "No build script for server, or script failed. Check package.json for correct script name"'
                    }
                }
            }
        }
        
        stage('Building Docker Images') {
            steps {
                script {
                    sh 'docker-compose build'
                }
            }
        }
        
       stage('Deploy to Nexus') {
    steps{
        script {
            docker.withRegistry("http://"+registry, registryCredentials) {
                sh('docker push $registry/nodemongoapp:6.0')
            }
        }
    }
}
    }
    
    post {
        always {
            echo 'Checking SonarQube scanner logs'
            sh 'ls -la .scannerwork || echo "No .scannerwork directory found"'
            sh 'cat .scannerwork/report-task.txt || echo "No SonarQube report found"'
        }
        success {
            echo 'Build completed successfully!'
        }
        failure {
            echo 'Build failed!'
        }
    }
}